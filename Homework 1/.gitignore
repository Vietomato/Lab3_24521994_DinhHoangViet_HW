# Dependencies and production output (at any project depth)
node_modules/
dist/
.npm-cache/
test-results/
playwright-report/

# Local environment configuration; keep safe example/template files visible
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Editor temporary and user-local files; preserve shared editor configuration
*~
*.swp
*.swo
*.tmp
*.bak
*.sublime-workspace
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/
.vscode/*.local.json

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
prompt_log.md
